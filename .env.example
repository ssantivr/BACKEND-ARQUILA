DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/arquila
# Optional: folder of the BASE-DE-DATOS-ARQUILA repository (migrations and seed.sql).
# Default: ../BASE-DE-DATOS-ARQUILA, next to this repository
DATABASE_DIR=
# Optional: address and port the API listens on. Defaults: 127.0.0.1 and 8000
API_HOST=
API_PORT=
UPLOAD_DIR=uploads
# Optional: disk or database. Use database where the disk is not kept, such as serverless
# hosting; files then go to the file_contents table. Default: disk
FILE_STORAGE=
# Optional: memory or database. Use database in production, and wherever memory is not kept
# between requests; the undo history and the attempt limits then go to the runtime_state
# table and are shared by every instance. memory is meant for development. Default: memory
STATE_STORAGE=
COOKIE_SECURE=0
# Optional: key of at least 32 bytes that signs the access tokens of /api/v1/auth/token.
# Without it no tokens are issued; the session cookie keeps working. Default: none
JWT_SECRET=
# Optional: lax, strict or none. Use none only when the interface runs on another site;
# it also forces a secure cookie. Default: lax
COOKIE_SAMESITE=
# Optional: DEBUG, INFO, WARNING or ERROR. Default: INFO
LOG_LEVEL=
# The assistant uses a local Ollama model, and fixed rules if Ollama is not running.
# Optional: local model and Ollama address. Defaults: first installed model, http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_URL=
APP_URL=http://localhost:5173
# Optional: comma-separated origins allowed to call the API from a browser. Default: APP_URL
CORS_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@arquila.local
